{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "groups": {
          "$groupId": {
            ".write": "auth != null && (auth.uid === $uid || root.child('groups').child($groupId).child('members').child(auth.uid).child('role').val() === 'admin' || root.child('groups').child($groupId).child('ownerId').val() === auth.uid)"
          }
        }
      }
    },

    "groups": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || (!newData.exists() ? (data.child('ownerId').val() === auth.uid || root.child('groups').child($groupId).child('ownerId').val() === auth.uid) : (root.child('groups').child($groupId).child('members').child(auth.uid).child('role').val() === 'admin' || root.child('groups').child($groupId).child('ownerId').val() === auth.uid)))",

        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('groups').child($groupId).child('members').child(auth.uid).child('role').val() === 'admin' || root.child('groups').child($groupId).child('ownerId').val() === auth.uid)"
          }
        }
      }
    },

    "transactions": {
      "$groupId": {
        ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
        "$txId": {
          ".write": "auth != null && (root.child('groups').child($groupId).child('members').child(auth.uid).child('role').val() === 'admin' || root.child('groups').child($groupId).child('ownerId').val() === auth.uid || (!data.exists() && newData.child('paidBy').val() === auth.uid && root.child('groups').child($groupId).child('members').child(auth.uid).exists()) || (data.exists() && data.child('paidBy').val() === auth.uid && (!newData.exists() || newData.child('paidBy').val() === auth.uid)))"
        }
      }
    },

    "scanLimits": {
      "$groupId": {
        ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
        "$date": {
          ".write": "auth != null && (root.child('groups').child($groupId).child('members').child(auth.uid).exists() || root.child('groups').child($groupId).child('ownerId').val() === auth.uid)",
          "count": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && (!data.exists() || newData.val() === data.val() + 1)"
          }
        }
      }
    },

    "categoryOverrides": {
      "$groupId": {
        ".read": "auth != null && root.child('groups').child($groupId).child('members').child(auth.uid).exists()",
        "$keyword": {
          ".write": "auth != null && (root.child('groups').child($groupId).child('members').child(auth.uid).exists() || root.child('groups').child($groupId).child('ownerId').val() === auth.uid)"
        }
      }
    }
  }
}